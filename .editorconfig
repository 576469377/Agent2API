# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{md,json,yml,yaml,html,css,js}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# 金帧样本：不得做行尾/空白规范化，否则会改变回放测试解析的内容
[fixtures/*.jsonl]
insert_final_newline = false
trim_trailing_whitespace = false

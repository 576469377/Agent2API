#!/bin/sh
# Scan exactly the staged Git bytes; diagnostics never include credential values.
set -eu
root=$(git rev-parse --show-toplevel)
if command -v python >/dev/null 2>&1; then
  runner=python
elif command -v python3 >/dev/null 2>&1; then
  runner=python3
else
  echo 'Commit blocked: install Python 3.9+ to run scripts/check-secrets.py.' >&2
  exit 1
fi
exec "$runner" "$root/scripts/check-secrets.py" --staged
